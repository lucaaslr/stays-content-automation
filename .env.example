STAYS_BASE_URL=https://ssmt.stays.com.br/i/home
STAYS_LOGIN=
STAYS_PASSWORD=

# Provedor de LLM: "ollama" (padrão local, sem chave de API), "anthropic" (Claude API)
# ou "claude_cli" (Claude Code CLI com login da assinatura, sem chave de API)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=600

# Chave de API e modelo para Anthropic (necessário apenas se LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Claude Code CLI (necessário apenas se LLM_PROVIDER=claude_cli; exige `claude` instalado e logado)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_SECONDS=300

# Modelos de URL usados com --id (marcador {property_id})
STAYS_PROPERTY_URL_TEMPLATE=https://ssmt.stays.com.br/i/apartment/{property_id}/setup
DEFAULT_SOURCE_URL_TEMPLATE=https://www.multitemporada.com/pt/apartment/{property_id}

HEADLESS=false
DRY_RUN=true
